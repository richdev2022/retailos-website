# ============================================================
# RetailOS Website — environment variables
# ============================================================
# Copy this file to `.env` for local dev, or set these as
# environment variables in your hosting provider (Render, Vercel,
# Netlify, Cloudflare Pages, etc.).
#
# On Render: dashboard → Environment → add each variable below.
# Or use render.yaml (Render Blueprint) — see render.yaml in this repo.
# ============================================================

# --- Web app URL (where Login / Get Started redirect to) ---
# This is the URL of the RetailOS web app (the dashboard / POS / inventory UI).
# The website's "Login" button redirects to ${VITE_WEBAPP_URL}/login
# The website's "Get Started" button redirects to ${VITE_WEBAPP_URL}/register
#
# Local dev:    http://localhost:5173
# Render prod:  https://retailos-web.onrender.com
# Custom domain: https://app.retailos.com
VITE_WEBAPP_URL=https://retailos-web.onrender.com

# --- Backend API URL (optional — currently unused on the marketing site) ---
# Set this if you ever want the website to call the backend directly
# (e.g. for a contact form or newsletter signup).
# Local dev:    http://localhost:4000
# Render prod:  https://retailos-backend.onrender.com
# Custom domain: https://api.retailos.com
VITE_API_URL=https://retailos-backend.onrender.com

# --- Admin portal URL (optional — used in footer / contact links) ---
# Local dev:    http://localhost:5174
# Render prod:  https://retailos-admin.onrender.com
# Custom domain: https://admin.retailos.com
VITE_ADMIN_URL=https://retailos-admin.onrender.com
